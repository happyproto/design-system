{
  "name": "@happyview/design-system",
  "version": "1.1.1",
  "description": "Design tokens and shared components for HappyProto, gated on WCAG AAA and colour-vision separation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happyproto/design-system.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css",
    "./logotype.light.svg": "./src/assets/logotype.light.svg",
    "./logotype.dark.svg": "./src/assets/logotype.dark.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/tokens.css",
    "src/components.css",
    "src/assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/bun": "^1.4.0",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.2.18",
    "culori": "^4.0.2",
    "echarts": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semantic-release": "^25.0.9",
    "storybook": "^10.6.0",
    "typescript": "^5"
  }
}
