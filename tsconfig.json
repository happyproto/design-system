{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": ["bun"]
  },
  "include": [
    "src",
    "tests",
    "stories",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ]
}
