{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["bun"]
  },
  "include": ["src", "stories", "tests", ".storybook/**/*.ts", ".storybook/**/*.tsx"]
}
