{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false
  },
  "include": ["src/index.ts", "src/tokens.ts"]
}
